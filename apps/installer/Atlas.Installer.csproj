<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Instalador-AtlasCad</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <PublishTrimmed>false</PublishTrimmed>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <AtlasInstallerSettingsPath Condition="'$(AtlasInstallerSettingsPath)' == ''">$(MSBuildThisFileDirectory)installer-settings.development.json</AtlasInstallerSettingsPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../packages/licensing/Atlas.Licensing.csproj" />
    <EmbeddedResource Include="$(AtlasInstallerSettingsPath)" LogicalName="Atlas.Installer.Settings.json" />
    <EmbeddedResource Include="$(AtlasInstallerPayloadPath)" LogicalName="Atlas.Installer.Payload.zip" Condition="'$(AtlasInstallerPayloadPath)' != '' and Exists('$(AtlasInstallerPayloadPath)')" />
  </ItemGroup>
</Project>
