POSTGRES_DB=atlascad
POSTGRES_USER=atlas
POSTGRES_PASSWORD=change-me-local-only
ConnectionStrings__Atlas=Host=localhost;Port=5432;Database=atlascad;Username=atlas;Password=change-me-local-only

# M4 licensing API (development values only; never commit real secrets/keys)
ATLAS_LICENSE_SIGNING_KEY_PATH=./secrets/server-signing-key.pk8
ATLAS_LICENSE_SIGNING_KEY_ID=atlas-prod-2026-01
ATLAS_LICENSE_ADMIN_KEY=replace-with-at-least-24-random-characters
ATLAS_LICENSE_API=http://127.0.0.1:5080
ATLAS_CATALOG_KEYS_PATH=./secrets/catalog-keys.json

# Commerce / Asaas (use sandbox until the complete acceptance test passes)
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_CHECKOUT_BASE_URL=https://sandbox.asaas.com/checkoutSession/show
# Keep single quotes: Asaas keys contain "$", which Compose otherwise interpolates.
ASAAS_API_KEY='replace-with-asaas-sandbox-api-key'
ASAAS_WEBHOOK_TOKEN=replace-with-at-least-32-random-characters
ATLAS_PUBLIC_WEB_URL=http://localhost:3000
ATLAS_INSTALLER_PATH=./App_Data/Instalador-AtlasCad.exe
ATLAS_UNINSTALLER_PATH=./App_Data/Desinstalar-AtlasCad.exe
ATLAS_PLAN_MONTHLY_PRICE=79.90
ATLAS_PLAN_YEARLY_PRICE=799.00
