<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AtlasAutoCadRuntime Condition="'$(AtlasAutoCadRuntime)' == ''">net10</AtlasAutoCadRuntime>
    <TargetFramework Condition="'$(AtlasAutoCadRuntime)' == 'net8'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(AtlasAutoCadRuntime)' != 'net8'">net10.0-windows</TargetFramework>
    <AutoCadApiVersion Condition="'$(AtlasAutoCadRuntime)' == 'net8'">25.0.1</AutoCadApiVersion>
    <AutoCadApiVersion Condition="'$(AtlasAutoCadRuntime)' != 'net8'">25.1.1</AutoCadApiVersion>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Atlas.AutoCAD.Adapter.2026</AssemblyName>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <RootNamespace>Atlas.AutoCAD.Adapter</RootNamespace>
    <AtlasSigningPublicKeyPath Condition="'$(AtlasSigningPublicKeyPath)' == ''">$(MSBuildThisFileDirectory)..\..\secrets\server-signing-public.json</AtlasSigningPublicKeyPath>
    <AtlasRuntimeConfigurationPath Condition="'$(AtlasRuntimeConfigurationPath)' == ''">$(MSBuildThisFileDirectory)..\..\secrets\runtime-configuration.json</AtlasRuntimeConfigurationPath>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
    <PackageReference Include="AutoCAD.NET" Version="$(AutoCadApiVersion)" PrivateAssets="all" />
    <ProjectReference Include="../atlas-core/Atlas.Cad.Core.csproj" />
    <Compile Include="../autocad-shared/**/*.cs" Link="Shared/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../atlas-licensing/**/*.cs" Link="Licensing/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../packages/licensing/**/*.cs"
             Exclude="../../packages/licensing/bin/**;../../packages/licensing/obj/**"
             Link="LicensingProtocol/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(AtlasSigningPublicKeyPath)" LogicalName="Atlas.SigningPublicKey.json" />
    <EmbeddedResource Include="$(AtlasRuntimeConfigurationPath)" LogicalName="Atlas.RuntimeConfiguration.json" />
  </ItemGroup>

  <Target Name="ValidateAutodeskReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(AtlasSigningPublicKeyPath)')" Text="Production signing public key was not found at '$(AtlasSigningPublicKeyPath)'." />
    <Error Condition="!Exists('$(AtlasRuntimeConfigurationPath)')" Text="Runtime configuration was not found at '$(AtlasRuntimeConfigurationPath)'." />
  </Target>
</Project>
