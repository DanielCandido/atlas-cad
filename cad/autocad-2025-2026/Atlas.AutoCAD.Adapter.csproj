<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Atlas.AutoCAD.Adapter.2026</AssemblyName>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <RootNamespace>Atlas.AutoCAD.Adapter</RootNamespace>
    <AutodeskAutoCADRoot Condition="'$(AutodeskAutoCADRoot)' == ''">$(AUTOCAD_2026_ROOT)</AutodeskAutoCADRoot>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
    <ProjectReference Include="../atlas-core/Atlas.Cad.Core.csproj" />
    <Compile Include="../autocad-shared/**/*.cs" Link="Shared/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../atlas-licensing/**/*.cs" Link="Licensing/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../packages/licensing/**/*.cs"
             Exclude="../../packages/licensing/bin/**;../../packages/licensing/obj/**"
             Link="LicensingProtocol/%(RecursiveDir)%(Filename)%(Extension)" />
    <Reference Include="AcMgd">
      <HintPath>$(AutodeskAutoCADRoot)/acmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcDbMgd">
      <HintPath>$(AutodeskAutoCADRoot)/acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcCoreMgd">
      <HintPath>$(AutodeskAutoCADRoot)/accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateAutodeskReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(AutodeskAutoCADRoot)' == ''"
           Text="Set AutodeskAutoCADRoot or AUTOCAD_2026_ROOT to the AutoCAD 2026 installation directory." />
    <Error Condition="!Exists('$(AutodeskAutoCADRoot)/acmgd.dll') Or !Exists('$(AutodeskAutoCADRoot)/acdbmgd.dll') Or !Exists('$(AutodeskAutoCADRoot)/accoremgd.dll')"
           Text="AutoCAD managed assemblies were not found under '$(AutodeskAutoCADRoot)'." />
  </Target>
</Project>
